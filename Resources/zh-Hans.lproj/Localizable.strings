/* Codex evidence */
"From the rollout log, which is newer than the turn database" = "来自更新的执行日志（轮次数据库可能滞后）";
"From the latest turn database record" = "来自最新轮次数据库记录";
"The agent asked a question that has no answer yet; waiting for you" = "Agent 提出的问题尚未得到回答，正在等你回复";
"The turn has not finished and %@ is running" = "轮次尚未结束，且 %@ 正在运行";
"The turn never finished and %@ has quit or restarted since its last activity" = "轮次没有正常结束，且 %@ 在最后一次活动之后已退出或重启";
"This turn finished; the overall task may still need follow-up" = "这一轮已结束，整个任务可能还需要跟进";
"The log changed after the last turn record, but no turn event could be read" = "最后一条轮次记录之后日志仍有变化，但没有读到轮次事件";
"The turn ended with an error or was stopped" = "轮次以错误结束或被停止";
"From the Codex CLI thread behind this Orca tab" = "来自该 Orca 标签页背后的 Codex CLI 对话";
"The turn has not finished and its Codex process still has the log open" = "轮次尚未结束，且对应的 Codex 进程仍打开着日志文件";
"The turn never finished and no Codex process has its log open anymore" = "轮次没有正常结束，且已没有 Codex 进程打开它的日志文件";
"Error: %@" = "错误：%@";
"The run returned an error" = "执行返回了错误信息";
"The source no longer lists this conversation while it was still active; the last record is kept until you accept it" = "对话仍在进行时，来源不再列出它；保留最后记录直到你确认验收";

/* Devin evidence */
"Devin returned ContentFilter: the model provider refused the request and it cannot be retried as is. Switch models or adjust the request." = "Devin 返回 ContentFilter：模型供应商拒绝了请求，且标记为不可原样重试；请更换模型或调整请求。";
"Trace ID: %@" = "trace ID：%@";
"Devin holds this session's lock and the latest message is not a final reply" = "Devin 持有此会话的执行锁，且最新消息还不是本轮的最终回复";
"Devin asked a question and is waiting for your answer" = "Devin 提出了问题，正在等你回答";
"The latest message is Devin's final reply for this turn" = "最新消息是 Devin 本轮的最终回复";
"The turn has no final reply and Devin no longer holds the session lock" = "本轮没有最终回复，且 Devin 已不再持有会话锁";
"No conversation turn was found in Devin's local session store" = "Devin 本地会话库中没有找到对话轮次";

/* Orca evidence */
"Orca saved this sleeping session as done; this is not a live signal" = "Orca 保存的休眠会话记录为 done；这不是实时运行信号";
"Conversation read from Orca; its remote or unrecorded execution status cannot be confirmed" = "已读取 Orca 中的具体对话；远端或未记录的执行状态暂时无法确认";
"Orca earlier recorded this terminal agent as running; its agentStatus is now cleared while the terminal still exists, so the turn has ended" = "Orca 曾记录该终端 Agent 正在执行；现在 agentStatus 已清除且终端仍存在，表示该轮已结束";
"Custom title of the Orca tab" = "来自 Orca 标签页自定义标题";
"Orca remote terminal title" = "来自 Orca 远程终端标题";
"From the worktreeId of the Orca remote agent" = "来自 Orca 远程 Agent 的 worktreeId";
"Orca's remote layout snapshot reports agentStatus %@: the terminal agent is running" = "Orca 远程布局快照中的 agentStatus 为 %@，该终端 Agent 正在执行";
"Orca reports agentStatus waiting and the terminal is marked Action Required: waiting for your input" = "Orca 的 agentStatus 为 waiting，且终端标记为 Action Required，正在等待你输入";
"Orca's remote layout snapshot reports agentStatus %@: this turn has ended" = "Orca 远程布局快照中的 agentStatus 为 %@，该轮已结束";
"Orca's remote layout snapshot reports agentStatus %@: execution failed" = "Orca 远程布局快照中的 agentStatus 为 %@，执行发生错误";
"Orca's remote layout snapshot reports agentStatus %@: execution was interrupted" = "Orca 远程布局快照中的 agentStatus 为 %@，执行已中断";
"Read an Orca remote terminal agent, but its status %@ cannot be interpreted" = "已读取 Orca 远程终端 Agent，但无法解释其状态 %@";
